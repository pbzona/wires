{
  "name": "wires-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run typecheck test build lint",
    "release:verify": "node scripts/smoke-starter.mjs --tarballs dist/npm --online",
    "release:dry-run": "turbo run npm:preview --filter=@pbzona/*",
    "release": "turbo run npm:publish --ui=tui --filter=@pbzona/*",
    "dev": "turbo run dev",
    "docs": "turbo run dev --filter=docs",
    "workbench": "turbo run build --filter=@pbzona/wires-editor && node scripts/smoke-starter.mjs --dev"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || >=26",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
