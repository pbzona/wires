{
  "name": "@pbzona/wires",
  "version": "0.1.0",
  "description": "A human-readable TypeScript toolkit for learning digital logic by building it from NAND gates up.",
  "keywords": [
    "digital-logic",
    "education",
    "learning",
    "nand",
    "logic-gates",
    "circuit-simulator"
  ],
  "license": "MIT",
  "author": "Phil Zona",
  "homepage": "https://github.com/pbzona/wires#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbzona/wires.git",
    "directory": "packages/wires"
  },
  "bugs": {
    "url": "https://github.com/pbzona/wires/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "examples": "pnpm build && node examples/01-gates.ts && node examples/02-composition.ts && node examples/03-four-bit-adder.ts && node examples/04-sr-latch.ts && node examples/05-register.ts",
    "release:pack": "pnpm --config.ignore-scripts=true pack --pack-destination ../../dist/npm",
    "npm:preview": "node ../../scripts/publish-tarball.mjs --dry-run",
    "npm:publish": "node ../../scripts/publish-tarball.mjs --publish",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
