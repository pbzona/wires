{
  "name": "@pbzona/create-wires",
  "version": "0.2.1",
  "description": "Create a local TypeScript workbench for building circuits with wires.",
  "license": "MIT",
  "author": "Phil Zona",
  "keywords": ["create", "vite", "digital-logic", "circuit-editor", "education"],
  "homepage": "https://github.com/pbzona/wires/tree/main/packages/create-wires#readme",
  "bugs": { "url": "https://github.com/pbzona/wires/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbzona/wires.git",
    "directory": "packages/create-wires"
  },
  "type": "module",
  "bin": { "create-wires": "bin/create-wires.js" },
  "files": [
    "bin/create-wires.js",
    "template/README.md",
    "template/gitignore",
    "template/index.html",
    "template/package.json",
    "template/tsconfig.json",
    "template/vite.config.ts",
    "template/chips/BufferGate.ts",
    "template/examples/Adder4.ts",
    "template/dev/save-chip.ts",
    "template/public/favicon.svg",
    "template/src/*.ts",
    "template/src/style.css"
  ],
  "scripts": {
    "typecheck": "tsc -p template/tsconfig.json",
    "test": "node --test tests/*.test.js",
    "release:pack": "pnpm --config.ignore-scripts=true pack --pack-destination ../../dist/npm",
    "npm:preview": "node ../../scripts/publish-tarball.mjs --dry-run",
    "npm:publish": "node ../../scripts/publish-tarball.mjs --publish",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "engines": { "node": "^24 || >=26" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "devDependencies": {
    "@pbzona/wires": "workspace:*",
    "@pbzona/wires-editor": "workspace:*",
    "@types/node": "^24.19.2",
    "rolldown": "~1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
